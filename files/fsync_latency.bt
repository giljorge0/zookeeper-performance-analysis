#!/usr/bin/env bpftrace
/*
 * fsync_latency.bt - latency histogram of fsync()/fdatasync() issued by ONE process (the ZooKeeper JVM).
 * Tests the log-sync stage of the write pipeline: every write is fsynced to the txn log before the ACK.
 * With -Dzookeeper.forceSync=no the count must drop to ~0 (a built-in check of the force_sync factor).
 * Usage: sudo bpftrace fsync_latency.bt <PID>
 */
tracepoint:syscalls:sys_enter_fsync,
tracepoint:syscalls:sys_enter_fdatasync
/pid == $1/
{
  @start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_fsync,
tracepoint:syscalls:sys_exit_fdatasync
/pid == $1 && @start[tid]/
{
  $us = (nsecs - @start[tid]) / 1000;
  @fsync_latency_us = hist($us);
  @fsync_calls = count();
  @fsync_total_us = sum($us);
  @fsync_max_us = max($us);
  delete(@start[tid]);
}

END { clear(@start); }
